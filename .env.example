# ---- Where inference runs (one switch, four lanes) -------------------------
# Flip lanes with:  make llm-target MODE=local|rented|claude|hybrid [URL=... MODEL=...]
#   local   chat on host Ollama (Metal)              — the laptop demo
#   rented  chat on vLLM over an OpenAI endpoint     — rented / dedicated GPU
#   claude  chat on Claude through a LiteLLM gateway — same OpenAI contract
#   hybrid  chat remote, embeddings + VLM local      — the data-residency split
LLM_PROVIDER=local
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
# Rented:  LLM_PROVIDER=rented  LLM_BASE_URL=http://gpu-box:8000/v1  LLM_API_KEY=<vllm key>
# Claude:  LLM_PROVIDER=claude  LLM_BASE_URL=http://litellm:4000/v1  LLM_API_KEY=<gateway key>
#          and ANTHROPIC_API_KEY for the gateway itself (never in agent code).

# Chat models (all served through the same graph; select in the UI).
# Local lanes use the curated registry in src/new_horizons/shared/llm/client.py;
# remote lanes
# list what the endpoint serves:
#   LLM_MODELS=qwen3-coder:30b
#   LLM_MODELS=claude-opus-5,claude-sonnet-5
LLM_MODEL_DEFAULT=qwen3:8b
LLM_NUM_CTX=8192

# Embeddings (bge-m3) and the vision model (qwen3-vl) are LOCAL models and never
# follow the chat endpoint — pin their host here when chat runs elsewhere.
OLLAMA_HOST=http://localhost:11434

# Embeddings + VLM (loaded on demand, keep_alive 0)
EMBED_MODEL=bge-m3
VLM_MODEL=qwen3-vl:4b

# ---- Postgres (five farm systems, audit chain, LangGraph checkpointer) ----
POSTGRES_PORT=5432
POSTGRES_PASSWORD=horizons
DATABASE_URL=postgresql://horizons:horizons@localhost:5432/horizons
# Read-only role used by the sql_query tool:
DATABASE_URL_RO=postgresql://farm_ro:farm-ro@localhost:5432/horizons

# ---- KB / ingest ----
KB_DIR=data/kb
# Generated data elsewhere (code stays in the checkout): HORIZONS_DATA=/path/to/data
RERANKER_ENABLED=false

# ---- Document intake ----
# Vision-model field extraction (qwen3-vl:4b, keep_alive 0); 0 = regex extractor only
# (use 0 whenever sojourner's tier stack is up — memory budget).
INTAKE_VLM=1
# OCR engine: tesseract (default, eng + ara+eng passes) | surya
# INTAKE_OCR=tesseract

# ---- App-agent host (`make host`) — per-tenant resources ----
# Each tenant resolves <ID>_DATABASE_URL-style and <ID>_KB_DIR on its own. The
# analytics tenant falls back to DATABASE_URL / KB_DIR above, so `make demo1`
# needs nothing new; set these only to point it elsewhere.
# ANALYTICS_DATABASE_URL=postgresql://horizons:horizons@localhost:5432/horizons
# ANALYTICS_KB_DIR=data/kb
# TEMPLATE_DATABASE_URL=

# Who records decisions in the audit chain (the demo has no sign-in; default: the OS user)
# HORIZONS_OPERATOR=Farm Manager
